%% Diagrama de containers C4 convertido de PlantUML para Mermaid flowchart com subgraphs.
flowchart TB
    bank["Agentes Financeiros<br/>Cliente externo que irá customizar os roteiros contábeis ou consultar um determinado evento contábel"]
    transactions["Sistema de Transações Financeiras<br/>Serviço responsável por gerenciar as transações financeiras"]
    migrations["Sistema de Migração de Contas<br/>Serviço que gerencia a migração das contas externas para o contexto da empresa"]
    datalake["Sistema de Relatórios<br/>Sistema que gerencia os relatórios financeiros e contábeis"]

    subgraph financial_accounting["Sistema de Contabilidade"]
        scripts["Serviço de Roteiros Contábeis<br/>Gerencia os roteiros contábeis customizados pelo cliente"]

        subgraph events_boundary["Serviço de Eventos Contábeis"]
            accounting_events["Serviço Gerenciamento de Eventos Contábeis<br/>Golang<br/>Gerencia os lançamentos contábeis processados pela plataforma"]
            accounting_transactions_worker["Processador de Eventos Financeiros<br/>Golang<br/>Processa os eventos financeiros gerados pela plataforma"]
            accounting_migrations_worker["Processador de Eventos de Migração<br/>Golang<br/>Processa os eventos financeiros de migração gerados pela plataforma"]
            sqs_transactions[("Fila de Mensagens<br/>SQS<br/>Consome os eventos de transação financeira produzidos pela plataforma")]
            sqs_migragions[("Fila de Mensagens<br/>SQS<br/>Consome os eventos de transação financeira de migração produzidos pela plataforma")]
            mySQL[("Banco de dados<br/>MySQL<br/>Armazena os dados dos Eventos contábeis")]
            sns_events[("Servidor de Mensagens<br/>SNS<br/>Notifica outros serviços sobre criação dos eventos contábeis")]
        end

        accounting_transactions_worker -->|"Consome os eventos de transação financeira<br/>JSON"| sqs_transactions
        accounting_migrations_worker -->|"Consome os eventos de transação financeira de migração<br/>JSON"| sqs_migragions
        accounting_events -->|"Persiste os eventos contábeis<br/>SQL"| mySQL
        accounting_events -->|"Publica os eventos contábeis<br/>JSON"| sns_events
        accounting_transactions_worker -->|"Lança um evento contábil<br/>JSON"| accounting_events
        accounting_migrations_worker -->|"Lança um evento contábil<br/>JSON"| accounting_events
        accounting_events -->|"Recupera um roteiro contábil para processar o evento<br/>JSON"| scripts
    end

    bank -->|"Customiza um roteiro contábel<br/>JSON"| scripts
    bank -->|"Consulta os lançamentos contábeis, ou efetuar um lançamento contábil avulso<br/>JSON"| accounting_events
    bank -->|"Lança um evento contábil avulso<br/>JSON"| accounting_events
    datalake -.->|"Consome os eventos processados para gerar relatórios contábeis<br/>DMS/SQL (async)"| mySQL
    sqs_transactions -->|"Subscribe tópico para processar eventos financeiros"| transactions
    sqs_migragions -->|"Subscribe tópico para processar eventos financeiros de migração"| migrations

    classDef external fill:#f5f5f5,stroke:#777,stroke-dasharray: 4 4,color:#333
    classDef goComponent fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef datastore fill:#fff3e0,stroke:#ef6c00,color:#e65100
    class bank,transactions,migrations,datalake,scripts external
    class accounting_events,accounting_transactions_worker,accounting_migrations_worker goComponent
    class sqs_transactions,sqs_migragions,mySQL,sns_events datastore
